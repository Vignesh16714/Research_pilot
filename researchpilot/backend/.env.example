# Which provider to use behind the shared LLM interface: "gemini" or "groq"
LLM_PROVIDER=gemini

# --- Gemini (https://ai.google.dev, free tier, no card required) ---
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (https://console.groq.com, free tier, no card required) ---
# Optional: only needed if LLM_PROVIDER=groq, or you want the voice
# upgrade path (Whisper transcription / PlayAI TTS) instead of the
# browser's built-in Web Speech API.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Arista-PlayAI

# --- Misc ---
# Comma-separated origins allowed to call this API from the browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max reflect->router loops per sub-task before forcing synthesis
MAX_LOOPS_PER_STEP=3
